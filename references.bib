 shorttitle = {p4est},
 title = {p4est: {Scalable} {Algorithms} for {Parallel} {Adaptive} {Mesh} {Refinement} on {Forests} of {Octrees}},
 url = {https://epubs.siam.org/doi/abs/10.1137/100791634},
 urldate = {2024-10-14},
 volume = {33},
 year = {2011},
