 pages = {2502--2522},
 title = {Exactly {Solving} {Hard} {Permutation} {Flowshop} {Scheduling} {Problems} on {Peta}-{Scale} {GPU}-{Accelerated} {Supercomputers}},
 url = {https://pubsonline.informs.org/doi/10.1287/ijoc.2022.1193},
 urldate = {2024-10-15},
 volume = {34},
