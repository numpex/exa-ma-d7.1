@article{hal_05547894,
 abstract = {With the growing maturity of additive manufacturing, the fabrication of architected or latticebased metamaterials has become a reality for industrial applications. These materials combine lightweight design with tailored mechanical properties, most of which exhibit pronounced nonlinear, especially large-deformation, behaviors. The main numerical challenge therefore lies in performing nonlinear simulations of such lattice structures, which may contain thousands of geometrically intricate unit cells, while lacking sufficient scale separation for multiscale homogenization schemes to be applicable straightforwardly. In this work, we propose a dedicated solver for the full volumetric fine-scale simulation of nonlinear hyperelastic lattice structures that drastically reduces both memory and computational costs. The key idea is to exploit the intrinsic self-similarity of the cells through a reduced-order modeling strategy applied within a domaindecomposition framework. At each Newton iteration, a limited set of principal cells is identified through a dedicated, weakly intrusive, EIM-like approach, allowing all local tangent operators to be expressed as linear combinations of a few principal ones. This enables fast and memoryefficient operator assembly, and then feeds an efficient inexact FETI-DP-based preconditioner at the solution stage, resulting in a quasi matrix-free algorithm for the nonlinear analysis. Numerical experiments in two and three dimensions demonstrate significant computational gains, with runtime reductions from several hours to a few tens of minutes and memory savings by factors of about three, while maintaining full fine-scale accuracy. Notably, the proposed strategy enables the computation of problems involving thousands of cells (i.e., millions of degrees of freedom) within a few minutes on an off-the-shelf laptop.},
 author = {Guillet, Clément and Hirschler, Thibaut and Jolivet, Pierre and Antolin, Pablo and Bouclier, Robin},
 journal = {Computer Methods in Applied Mechanics and Engineering},
 keywords = {project:Exa-MA, source:HAL},
 language = {en},
 month = {November},
 pages = {119202},
 title = {Efficient {Fine}-{Scale} {Simulation} of {Nonlinear} {Hyperelastic} {Lattice} {Structures}},
 url = {https://hal.science/hal-05547894},
 volume = {461},
 year = {2026},
 zotero-key = {SEU4ZIPQ}
}

@misc{hal_05628912,
 abstract = {This article is concerned with domain decomposition preconditioners, and more particularly the additive Schwarz method (ASM) with a coarse space based on the GenEO (Generalized Eigenproblem in the Overlap) method, to solve large sparse symmetric positive definite problems. While such preconditioners can achieve scalability by being efficiently parallelized, they still require linear algebra operations in each local subdomain that can be quite expensive in time and memory. Motivated by the emergence of fast, low precision arithmetic in hardware, in this work we aim to reduce the costs of ASM-GenEO preconditioners using mixed precision. In order to determine which parts of these preconditioners can be switched to lower precision, we carry out a perturbation analysis that identifies the sensitivity of the different operations. We obtain theoretical error bounds that show that the precision selection should be guided by the local matrix condition numbers. This provides an actionable criterion for selecting the appropriate precision for each local subdomain while maintaining rigorous guarantees on the efficiency of the preconditioner. We perform extensive numerical experiments to validate our theoretical bounds and assess their sharpness. Overall, this study thus demonstrates that domain decomposition preconditioners can be constructed in mixed precision while reliably controlling their efficiency.},
 author = {Caruso, Tom and Jolivet, Pierre and Mary, Theo and Nataf, Frédéric and Tournier, Pierre-Henri},
 keywords = {project:Exa-MA, source:HAL},
 language = {en},
 month = {May},
 title = {Mixed {Precision} {Perturbation} {Analysis} of {Two}-{Level} {Domain} {Decomposition} {Preconditioners}},
 url = {https://hal.science/hal-05628912},
 year = {2026},
 zotero-key = {4MNWTARK}
}

@inproceedings{hal_05631839,
 abstract = {La discrétisation de problèmes de propagation d’ondes en régime harmonique par éléments finis conduit à des systèmes linéaires coûteux à résoudre. Nous considérons une méthode d’éléments finis discontinus hybridisée en utilisant des variables de transmission aux interfaces entre les mailles. Cette approche permet d’accélérer la convergence des schémas itératifs et possède une structure algo- rithmique adaptée au calcul parallèle, notamment sur cartes graphiques. Nous présentons et étudions des implémentations de cette méthode au moyen de résultats 3D obtenus avec un code C++ dédié.},
 author = {Modave, Axel and Greffe, Roland and Geuzaine, Christophe and Rappaport, Ari and Chabib, Ahmed},
 booktitle = {{CSMA} 2026 - 17ème {Colloque} {National} en {Calcul} des {Structures}},
 keywords = {project:Exa-MA, source:HAL},
 language = {fr},
 month = {May},
 title = {Méthode d'éléments finis discontinus hybridisée pour la résolution itérative accélérée de problèmes d'ondes en fréquence},
 url = {https://hal.science/hal-05631839},
 year = {2026},
 zotero-key = {5CCXQ38Z}
}

@misc{hal_05640144,
 abstract = {Mixed-precision Krylov subspace methods can exploit low-precision LU factorizations as preconditioners to reduce the cost of solving large sparse linear systems. Flexible GMRES is widely used for its robustness on ill-conditioned problems; however, it requires roughly twice the storage for the Krylov basis. Classical (non-flexible) GMRES is therefore more suitable in memory-constrained environments, but it requires the LU factors to be applied in high precision. In this work, we show how recent advances in memory accessor techniques enable non-flexible mixed-precision GMRES. Memory accessors decouple storage and compute precision in bandwidth-bound kernels, allowing efficient high-precision application of the preconditioner while retaining low-precision storage. We leverage MUMPS for the LU preconditioner, which combines low precision with block low-rank compression, and PETSc for the GMRES solvers. We benchmark these approaches on a broad set of large-scale, real-world industrial sparse matrices. Our results demonstrate that classical GMRES with memory accessors offers a clear advantage over flexible GMRES when minimizing memory usage. When minimizing time, the comparison is less definitive: although classical GMRES can significantly reduce iteration counts by allowing a larger restart window within the same memory budget, these gains do not consistently translate into runtime improvements due to memory accessor overhead. Overall, this work positions non-flexible, memory accessor-based GMRES as a new contender in terms of time-memory tradeoff.},
 author = {Amestoy, Patrick and El Habti, Ouassel and Jego, Antoine and L'Excellent, Jean-Yves and Mary, Theo},
 keywords = {project:Exa-MA, source:HAL},
 language = {en},
 month = {June},
 title = {Enabling non-{Flexible} {Mixed}-{Precision} {Preconditioned} {GMRES} with {Memory} {Accessors}},
 url = {https://hal.science/hal-05640144},
 year = {2026},
 zotero-key = {27672AVE}
}

@misc{hal_05640503,
 abstract = {We present a mixed precision approach for improving Tucker-based lossy compression of multiway data. Current Tucker decomposition algorithms use a uniform floating-point precision and obtain compression by minimizing the multilinear ranks of the representation subject to the target error tolerance. Our algorithm automatically determines which parameters of the representation can be stored in lower precision to improve the compression ratio without exceeding the error tolerance. Crucially, we show that the opportunities to reduce precision are not uniform across parameters, and thus using multiple precisions allows for smoothly transitioning across tolerances between the precisions of standard formats. Theoretical error bounds and numerical experiments validate the approach, and we obtain up to 2× and 4× compression improvement factors over initial Tucker approximations of single and double precision real-world numerical simulation data, respectively.},
 author = {Ballard, Grey and Mary, Theo and Verma, Bhisham},
 keywords = {project:Exa-MA, source:HAL},
 language = {en},
 month = {June},
 title = {Mixed {Precision} {Compression} of {Tucker} {Decomposition}},
 url = {https://hal.science/hal-05640503},
 year = {2026},
 zotero-key = {HNCKMASQ}
}

@misc{hal_05640635,
 abstract = {{\textless}div{\textgreater}{\textless}p{\textgreater}We introduce a doubly adaptive precision variant of restarted generalized minimal residual (GMRES) for modern multicore processors that combines two complementary mechanisms to reduce solver cost: relaxed GMRES, which progressively enlarges the admissible matrix-vector product error during the iterations, and the adaptive precision sparse matrix-vector product (SpMV) algorithm, which stores matrix entries in heterogeneous precisions according to their magnitudes and a given accuracy. The proposed method couples temporal relaxation of the admissible perturbation with spatial precision assignment, storing each matrix entry in the lowest format compatible with the current SpMV error bound. Because the theoretical error bound is often conservative in practice, we introduce several relaxation heuristics and combine them with restarted GMRES to preserve attainable accuracy while increasing the use of low precisions. Numerical experiments show that this doubly adaptive strategy exploits low precision more effectively than either mechanism used independently, achieving speedups of up to 1.6× over a double precision GMRES baseline while preserving the target backward error across a broad range of problems.{\textless}/p{\textgreater}{\textless}/div{\textgreater}},
 author = {Agullo, Emmanuel and Giraud, Luc and Jolivet, Pierre and Mary, Theo and Tabouret, Alexandre},
 keywords = {project:Exa-MA, source:HAL},
 language = {en},
 month = {June},
 title = {Doubly adaptive precision restarted {GMRES}},
 url = {https://hal.science/hal-05640635},
 year = {2026},
 zotero-key = {T8DS97WD}
}

