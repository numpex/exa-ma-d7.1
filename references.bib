}

@misc{hal_05692733,
 abstract = {The interpolative decomposition (ID), which originates from the column subset selection problem, can be used to compute a low-rank approximation of data that are represented in matrix form. Computing an ID commonly requires pivoted factorizations with rank-revealing properties that offer a robust column selection but suffer from high operational complexity and inefficient data access patterns that limit their efficiency. Randomization can be employed to overcome these limitations by restricting inefficient operations to a small row or column sample of the data called the sketch. This technique lends itself very naturally to the case where the rank of the ID is fixed beforehand. In this work, we take interest in the case where the rank is not known but, rather, a target accuracy for the ID is prescribed. In this context, we present a novel randomized algorithm for computing the ID that relies on an efficient scheme that incrementally builds the sketch and selects its columns through the updating of its column-pivoted QR factorization. Our approach seamlessly integrates oversampling and, through this parameter, allows for achieving a favorable trade-off between reducing the operational complexity to form an ID and reducing the rank of the final low-rank approximation. Furthermore, we present a reliable criterion based on the Johnson-Lindenstrauss lemma for stopping this process when the prescribed threshold ε is achieved. We finally present experimental results demonstrating that our algorithm can accurately and robustly compute the fixed-accuracy ID of a dense matrix with a final rank that is lower than other methods from the related literature.},
 author = {Buttari, Alfredo and Hoogveld, Karmijn and Mary, Theo},
 keywords = {project:Exa-MA, source:HAL},
 language = {en},
 month = {July},
 title = {A fixed-accuracy randomized interpolative decomposition based on pivoted {QR}},
 url = {https://hal.science/hal-05692733},
 year = {2026},
 zotero-key = {ADMUHVJN}
}

@misc{hal_05705668,
 abstract = {Finite-precision arithmetic unavoidably introduces numerical approximation errors. Numerical computations may use insufficient precision or an improper formulation, which leads to numerical instability. In this paper, we introduce a unified software tool for stochastic numerical validation of deep-learning operators. The tool follows CESTAC on supported exposed operations and uses an operator-level data-perturbation approximation for GEMM-like kernels. Our developed software not only enables numerical validation with a single computation pass but also detects the sources of numerical instability and provides numerical stability monitoring during deep learning training and inference. We verified its effectiveness on the detection of polluted operators with injected numerical instabilities across various tasks. We believe that our developed method and tools provide valuable insights into developing numerically stable computing kernels, which are particularly critical for numerically stable and efficient deep learning training and inference. Our software is publicly available at {\textbackslash}url\{https://github.com/chenxinye/noisefloat\}.},
 author = {Chen, Xinye},
 keywords = {project:Exa-MA, source:HAL},
 language = {en},
 month = {August},
 title = {Automated {Numerical} {Stability} {Analysis} of {Deep} {Learning} {Operators}},
 url = {https://hal.science/hal-05705668},
 year = {2026},
 zotero-key = {GT6CQJ6E}
}

@article{hal_05709072,
 abstract = {The success of large language models (LLMs) for time series has been demonstrated in previous work. Utilizing a symbolic time series representation, one can efficiently bridge the gap between LLMs and time series. However, the remaining challenge is to exploit the semantic information hidden in time series by using symbols or existing tokens of LLMs, while aligning the embedding space of LLMs according to the hidden information of time series. The symbolic time series approximation (STSA) method called adaptive Brownian bridge-based symbolic aggregation (ABBA) shows outstanding efficacy in preserving salient time series features by modeling time series patterns in terms of amplitude and period while using existing tokens of LLMs. In this paper, we introduce a method, called LLM-ABBA, that integrates ABBA into large language models for various downstream time series tasks. By symbolizing time series, LLM-ABBA compares favorably to the recent state-of-the-art (SOTA) in UCR and three medical time series classification tasks. Meanwhile, a fixed-polygonal chain trick in ABBA is introduced to avoid obvious drifting during forecasting tasks by significantly mitigating the effects of cumulative error arising from misused symbols during the transition from symbols to numerical values. In time series regression tasks, LLM-ABBA achieves the new SOTA on Time Series Extrinsic Regression (TSER) benchmarks. LLM-ABBA also shows competitive forecasting capability compared to recent SOTA time series forecasting results. We believe this framework can also seamlessly extend to other time series tasks. Our simulation code is publicly available at: https://github.com/inEXASCALE/llm-abba.},
 author = {Chen, Xinye and Carson, Erin and Kang, Cheng},
 doi = {10.1109/tsp.2026.3662011},
 journal = {IEEE Transactions on Signal Processing},
 keywords = {project:Exa-MA, source:HAL},
 language = {en},
 month = {February},
 pages = {1218--1232},
 title = {{LLM}-{ABBA}: {Understanding} time series via symbolic approximation},
 url = {https://hal.science/hal-05709072},
 volume = {74},
 year = {2026},
 zotero-key = {3UDIG6B2}
}

@misc{hal_05734003,
 abstract = {{\textless}div{\textgreater}{\textless}p{\textgreater}The rapid expansion of time-series data collected by sensors and monitoring systems has made compact representations increasingly important. These representations need to keep the main structure of the signal while cutting storage, transmission and computation costs. One effective route is to convert long numerical series into short symbolic sequences. Adaptive Brownian Bridge-based Aggregation (ABBA) is a recent method that does this well: it preserves the overall shape of the series and works for tasks such as anomaly detection and forecasting.{\textless}/p{\textgreater}{\textless}p{\textgreater}Three practical questions are still open. First, can the storage needed for ABBA's parameters be reduced further? Second, can the method run more efficiently if low-precision arithmetic is used? Third, can the symbolic sequences produced by ABBA be understood directly by large language models? We address these points with Quantized ABBA (QABBA), a quantized version of ABBA. By quantizing the symbolic centers, QABBA shrinks the parameter footprint and allows integer arithmetic, yet reconstruction quality remains high. We also prove several error bounds that account for the extra approximation introduced by quantization: a dimension-free bound on the excess error of each segment, a reconstruction-error bound in the time domain, a stability condition for the symbolic assignment step, and a simple rule for allocating bits between segment lengths and increments.{\textless}/p{\textgreater}{\textless}p{\textgreater}Because the resulting symbolic strings are short and discrete, they can be passed straight to a pretrained large language model (LLM) without any extra time-series embedding layer. Experiments on the Monash regression archive, the UCR Time Series Classification Archive, and the UEA Multivariate Time Series Classification Archive show that the method offers a usable compromise among storage size, reconstruction accuracy and downstream predictive performance. These results show that QABBA provides an effective low-precision symbolic representation for time-series signals, while also supporting LLM-based time-series analysis.{\textless}/p{\textgreater}{\textless}p{\textgreater}Our software is made publicly accessible in https://github.com/inEXASCALE/qabba.{\textless}/p{\textgreater}{\textless}/div{\textgreater}},
 author = {Carson, Erin and Chen, Xinye and He, Fei and Kang, Cheng},
 keywords = {project:Exa-MA, source:HAL},
 language = {en},
 month = {September},
 title = {{QABBA}: {Symbolic} {Time} {Series} {Compression} via {Integer}-{Quantized} {Aggregation}},
 url = {https://hal.science/hal-05734003},
 year = {2026},
 zotero-key = {XM6VVG8Z}
}

