#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

# Default values
DEFAULT_ZOTERO_USER_ID=""
DEFAULT_ZOTERO_API_KEY=""
DEFAULT_ZOTERO_GROUP_ID="5582837"
DEFAULT_BIBTEX_FILE="references.bib"
COLLECTION_ID=""

# Read environment variables or set defaults
ZOTERO_USER_ID=${ZOTERO_USER_ID:-$DEFAULT_ZOTERO_USER_ID}
ZOTERO_API_KEY=${ZOTERO_API_KEY:-$DEFAULT_ZOTERO_API_KEY}
ZOTERO_GROUP_ID=${ZOTERO_GROUP_ID:-$DEFAULT_ZOTERO_GROUP_ID}
BIBTEX_FILE=${BIBTEX_FILE:-$DEFAULT_BIBTEX_FILE}

# Function to parse command-line arguments
parse_args() {
    while [[ "$#" -gt 0 ]]; do
        case $1 in
            --zotero-user-id) ZOTERO_USER_ID="$2"; shift ;;
            --zotero-api-key) ZOTERO_API_KEY="$2"; shift ;;
            --zotero-group-id) ZOTERO_GROUP_ID="$2"; shift ;;
            --bibtex-file) BIBTEX_FILE="$2"; shift ;;
            --help)
                echo "Usage: $0 [options] {setup|create|list|delete|update-bibtex} [version]"
                echo "Options:"
                echo "  --zotero-user-id    Zotero User ID"
                echo "  --zotero-api-key    Zotero API Key"
                echo "  --zotero-group-id   Zotero Group ID (optional, omit if using user library)"
                echo "  --bibtex-file       Path to the BibTeX file (default: your_bibtex_file.bib)"
                echo "Commands:"
                echo "  setup               : Setup hooks for commit, checkout, and merge"
                echo "  create              : Create a new release with the provided version"
                echo "  list                : List all existing releases"
                echo "  delete              : Delete the release with the provided version"
                echo "  update-bibtex       : Fetch and update the BibTeX file from Zotero"
                echo "  version             : Optional argument specifying the version for create and delete commands"
                exit 0 ;;
        esac
        shift
    done
}

# Function to setup hooks
setup() {
    for i in commit checkout merge; do
        cp hooks/post-commit .git/hooks/post-$i
        chmod +x .git/hooks/post-$i
    done
    echo "Hooks setup successfully."

    git checkout

    if ! test -f .git/gitHeadInfo.gin; then
        cp .git/gitHeadInfo.gin gitHeadLocal.gin

        git add gitHeadLocal.gin
        git commit -m "Created gitHeadLocal.gin for initial setup"
    fi
}

# Function to create a release
create_release() {
    VERSION=$1

    if [ -z "$VERSION" ]; then
        echo "Usage: $0 create vx.y.z"
        exit 1
    fi

    # Check if the tag already exists
    if git rev-parse "$VERSION" >/dev/null 2>&1; then
        echo "Error: Tag $VERSION already exists."
        exit 1
    fi

    # Check the format of the version number
    if [[ ! "$VERSION" =~ ^v[0-9]+\.[0-9]+\.[0-9]+(-[a-z]+\.[0-9]+)?$ ]]; then
        echo "Error: Version number should be in the format vx.y.z or vx.y.z-pre.a."
        exit 1
    fi

    # Tag the repository with the provided version
    git tag -a "$VERSION" -m "Release $VERSION"

    # Checkout the tag to trigger post-commit hook to update gitinfo2 info file
    git checkout

    # Show the reltag line of .git/gitHeadInfo.gin
    grep reltag .git/gitHeadInfo.gin

    cp .git/gitHeadInfo.gin gitHeadLocal.gin

    git add gitHeadLocal.gin
    git commit -m "Updated gitHeadLocal.gin for release $VERSION"
    git tag -f -a "$VERSION" -m "Release $VERSION"

    # Push the changes and the tags
    git push origin --follow-tags

    echo "Release $VERSION created and pushed successfully."
}

# Function to list releases
list_releases() {
    git tag --sort=-creatordate | head -n $1
}

# Function to clean latex build files
clean() {
    # clean latex build files
    rm -f *.aux *.bbl *.blg *.log *.out *.pyg *.fls *.synctex* *.toc *.fdb_latexmk *.fls *.idx *.ilg *.ind *.chl *.lof *.lot *.pdf
}

# Function for fast compilation
compile() {
    PART=${1:-"all"}
    DOC="exa-ma-d7.1.tex"
    
    echo "🚀 Fast compilation for: $PART"
    
    # Backup original file
    cp "$DOC" "${DOC}.backup"
    
    case $PART in
        "wp"|"wps")
            echo "Compiling only Work Packages (WP1-WP6)..."
            sed -i.tmp 's/%\\includeonly{chapters\/WPs}/\\includeonly{chapters\/WPs}/' "$DOC"
            ;;
        "methodology"|"methodo")
            echo "Compiling only Methodology chapter..."
            sed -i.tmp 's/%\\includeonly{chapters\/methodology}/\\includeonly{chapters\/methodology}/' "$DOC"
            ;;
        "applications"|"apps")
            echo "Compiling only Applications chapter..."
            sed -i.tmp 's/%\\includeonly{chapters\/applications}/\\includeonly{chapters\/applications}/' "$DOC"
            ;;
        "software"|"soft")
            echo "Compiling only Software chapter..."
            sed -i.tmp 's/%\\includeonly{chapters\/software}/\\includeonly{chapters\/software}/' "$DOC"
            ;;
        "wp-methodo")
            echo "Compiling WPs + Methodology..."
            sed -i.tmp 's/%\\includeonly{chapters\/WPs,chapters\/methodology}/\\includeonly{chapters\/WPs,chapters\/methodology}/' "$DOC"
            ;;
        "apps-soft")
            echo "Compiling Applications + Software..."
            sed -i.tmp 's/%\\includeonly{chapters\/applications,chapters\/software}/\\includeonly{chapters\/applications,chapters\/software}/' "$DOC"
            ;;
        "all")
            echo "Full compilation..."
            ;;
        "draft")
            echo "Draft mode compilation (ultra-fast)..."
            pdflatex --shell-escape -interaction=nonstopmode -draftmode "$DOC"
            echo "✅ Draft compilation completed - check for errors only"
            return 0
            ;;
        *)
            echo "❌ Unknown part: $PART"
            echo "Available parts: wp, methodology, applications, software, wp-methodo, apps-soft, all, draft"
            rm -f "${DOC}.backup"
            return 1
            ;;
    esac
    
    # Compile with latexmk
    echo "📖 Compiling with latexmk..."
    if latexmk --shell-escape -pdf -interaction=nonstopmode -silent "$DOC"; then
        echo "✅ Compilation successful!"
        
        # Show PDF size and page count
        if [ -f "exa-ma-d7.1.pdf" ]; then
            SIZE=$(du -h exa-ma-d7.1.pdf | cut -f1)
            PAGES=$(pdfinfo exa-ma-d7.1.pdf 2>/dev/null | grep Pages | awk '{print $2}')
            echo "📄 PDF: $SIZE, $PAGES pages"
        fi
    else
        echo "❌ Compilation failed!"
        return 1
    fi
    
    # Restore original file
    mv "${DOC}.backup" "$DOC"
    rm -f "${DOC}.tmp"
    
    echo "🔄 Original file restored"
}
# Function to delete a release
delete_release() {
    VERSION=$1

    if [ -z "$VERSION" ]; then
        echo "Usage: $0 delete vx.y.z"
        exit 1
    fi

    # Delete the tag locally
    git tag -d "$VERSION"

    # Delete the tag remotely
    # git push origin --delete "$VERSION"

    echo "Release $VERSION deleted successfully."
}

# Use the same validated, atomic exporter as the scheduled workflow.
update_bibtex() {
    if [ -n "$ZOTERO_GROUP_ID" ]; then
        library_args=(--group-id "$ZOTERO_GROUP_ID")
    else
        library_args=(--user-id "$ZOTERO_USER_ID")
    fi
    ZOTERO_API_KEY="$ZOTERO_API_KEY" uv run --no-project --python 3.11 \
        --with bibtexparser==1.4.3 python "$(dirname "$0")/scripts/update_bibliography.py" \
        "${library_args[@]}" --output "$BIBTEX_FILE"
}

# Main script logic
parse_args "$@"

case "$1" in
    setup)
        setup
        ;;
    clean)
        clean
        ;;
    compile)
        compile "$2"
        ;;
    create)
        create_release "$2"
        ;;
    list)
        list_releases "${2:-5}"
        ;;
    delete)
        delete_release "$2"
        ;;
    update-bibtex)
        update_bibtex
        ;;
    *)
        echo "Usage: $0 [options] {setup|clean|compile|create|list|delete|update-bibtex} [version]"
        echo "Options:"
        echo "  --zotero-user-id    Zotero User ID (optional, omit if using group id given)"
        echo "  --zotero-api-key    Zotero API Key"
        echo "  --zotero-group-id   Zotero Group ID (optional, omit if using user id given)"
        echo "  --bibtex-file       Path to the BibTeX file (default: your_bibtex_file.bib)"
        echo "Commands:"
        echo "  setup               : Setup hooks for commit, checkout, and merge"
        echo "  clean               : Clean latex build files"
        echo "  compile [part]      : Fast compilation (wp, methodology, applications, software, all, draft)"
        echo "  create              : Create a new release with the provided version"
        echo "  list                : List all existing releases"
        echo "  delete              : Delete the release with the provided version"
        echo "  update-bibtex       : Fetch and update the BibTeX file from Zotero"
        echo ""
        echo "Compile examples:"
        echo "  ./a.cli compile wp           # Compile only Work Packages (fast)"
        echo "  ./a.cli compile methodology  # Compile only methodology chapter"
        echo "  ./a.cli compile draft        # Ultra-fast draft mode"
        echo "  ./a.cli compile all          # Full compilation"
        exit 1
        ;;
esac
